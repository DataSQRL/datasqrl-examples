CREATE TABLE _Heartbeats (
  sensorId INT NOT NULL,
  event_time AS NOW(),
  WATERMARK FOR event_time AS event_time - INTERVAL '5' SECOND
) WITH (
  'connector' = 'datagen',
  'rows-per-second' = '1',
  'fields.sensorId.kind' = 'random',
  'fields.sensorId.min' = '1',
  'fields.sensorId.max' = '3'
);

/**
  Latest heartbeat of each sensor
 */
LatestHeartbeat := DISTINCT _Heartbeats ON sensorId ORDER BY event_time DESC;

-- Minute within a 30-day cycle, so a new minute overwrites the one from 30 days ago.
_HeartbeatSlots := SELECT
  MOD(TIMESTAMPDIFF(MINUTE, TIMESTAMP '1970-01-01 00:00:00', window_start), 43200) AS minute_slot,
  window_start, window_time, COUNT(*) AS heartbeat_count
FROM TUMBLE(TABLE _Heartbeats, DESCRIPTOR(event_time), INTERVAL '1' MINUTE)
GROUP BY window_start, window_end, window_time;

_HeartbeatsPerMinute := DISTINCT _HeartbeatSlots ON minute_slot ORDER BY window_time DESC;

/**
  Minutes that received heartbeats since fromTime, oldest first. A minute without heartbeats has no row.
 */
HeartbeatMinutes(fromTime TIMESTAMP NOT NULL) :=
SELECT window_start, heartbeat_count
FROM _HeartbeatsPerMinute WHERE :fromTime <= window_start
ORDER BY window_start ASC;
