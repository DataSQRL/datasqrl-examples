{
  "version": "1",
  "enabled-engines": ["vertx", "postgres", "flink"],
  "script": {
    "main": "long-lived-batch.sqrl"
  },
  "engines": {
    "flink": {
      "config": {
        "execution.runtime-mode": "BATCH"
      },
      "deployment": {
        "jobmanager-size": "dev",
        "jobmanager-cpu-request-factor": 0.1,
        "taskmanager-size": "dev",
        "taskmanager-cpu-request-factor": 0.1,
        "taskmanager-count": 1,
        "schedule": {
          "cron": "0 */3 * * *",
          "timezone": "UTC"
        }
      }
    },
    "postgres": {
      "deployment": {
        "instance-size": "dev",
        "cpu-request-factor": 0.1,
        "replica-count": 0
      }
    },
    "vertx": {
      "deployment": {
        "instance-size": "dev",
        "cpu-request-factor": 0.1,
        "instance-count": 1
      }
    }
  }
}
