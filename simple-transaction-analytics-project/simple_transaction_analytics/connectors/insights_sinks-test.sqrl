-- ## Insights Sinks - Test
--
-- Write the insight tables to a local Iceberg warehouse for tests and local runs.

IMPORT insights_sinks.*;

CREATE TABLE Customer_Month_Category_L1_Spending (
  PRIMARY KEY (customer_id, `month`, category_l1_id) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'spending_insights',
    'catalog-database' = 'insights',
    'catalog-table' = 'customer_month_category_l1_spending',
    'warehouse' = 'simple_transaction_analytics/sqrl_iceberg_data/',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE _Customer_Month_Category_L1_Spending_schema;

