{
  "version": "1",
  "enabled-engines": ["vertx", "postgres", "kafka", "flink"],
  "script": {
    "main": "operations_agent.sqrl",
    "include": {
      "data-catalog": {
        "package": "../data-catalog/ontology-shared-package.json"
      }
    }
  },
  "engines": {
    "flink": {
      "config": {
        "table.exec.source.idle-timeout": "1 s"
      }
    }
  }
}
