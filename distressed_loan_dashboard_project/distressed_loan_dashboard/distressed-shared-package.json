{
  "version": "1",
  "enabled-engines": ["flink", "postgres", "vertx"],
  "script": {
    "main": "pipeline.sqrl",
    "include": {
      "data_catalog": {
        "package": "../data-catalog/ontology-test-package.json"
      }
    }
  },
  "engines": {
    "flink": {
      "config": {
        "execution.runtime-mode": "BATCH"
      }
    }
  },
  "compiler": {
    "api": {
      "protocols": ["GRAPHQL", "MCP"]
    }
  }
}
