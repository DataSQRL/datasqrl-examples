-- Production connectors: bounded Kafka reads for the nightly batch.
-- Each table mirrors the test connector's shape; `ingested_at` comes from the
-- Kafka record timestamp (metadata) and the source is bounded to latest-offset
-- so the batch job reads the current snapshot and finishes.

IMPORT sources.*;

CREATE TABLE Loan_Payment (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka-safe',
    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = 'consumer_loans.loan_payment',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE loan_schema.Loan_Payment_schema;

