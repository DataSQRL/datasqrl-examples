-- Test connectors: filesystem over this project's controlled test data.
-- Each table mirrors the production connector's shape (same names, same
-- physical payload via `LIKE <alias>.<Name>_schema`), reading static JSONL.

IMPORT sources.*;

CREATE TABLE Loan_Payment (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/loan_payment.jsonl',
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE loan_schema.Loan_Payment_schema;

