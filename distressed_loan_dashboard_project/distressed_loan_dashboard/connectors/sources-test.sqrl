-- Project-owned filesystem test connectors, standing in for the catalog's
-- production Kafka connectors. Table names match the catalog's production
-- table names so the main script is environment-agnostic.

IMPORT root.data_catalog.customer.customer_data.customer_master;
IMPORT root.data_catalog.lending.cards_consumer_credit.consumer_loans;
IMPORT root.data_catalog.lending.cards_consumer_credit.credit_cards;
IMPORT root.data_catalog.lending.mortgages.mortgage_originations;
IMPORT root.data_catalog.lending.mortgages.mortgage_servicing;

CREATE TABLE Customer (
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer.jsonl',
    'format' = 'flexible-json',
    'flexible-json.timestamp-format.standard' = 'ISO-8601'
) LIKE customer_master.Customer_schema;

CREATE TABLE Customer_Address (
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_address.jsonl',
    'format' = 'flexible-json',
    'flexible-json.timestamp-format.standard' = 'ISO-8601'
) LIKE customer_master.Customer_Address_schema;

