-- ## Credit Risk Signals - Test Data
--
-- Use local filesystem data for testing

IMPORT credit_risk_signals.*;

CREATE TABLE Customer_Credit_Exposure (
  /** Timestamp when exposure was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/credit_risk_signals-customer_credit_exposure.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Credit_Exposure_schema;

CREATE TABLE Payment_Behavior (
  /** Timestamp when behavior was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/credit_risk_signals-payment_behavior.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Payment_Behavior_schema;

CREATE TABLE Delinquency_Rollforward (
  /** Timestamp when rollforward was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/credit_risk_signals-delinquency_rollforward.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Delinquency_Rollforward_schema;

CREATE TABLE Credit_Utilization (
  /** Timestamp when utilization was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/credit_risk_signals-credit_utilization.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Credit_Utilization_schema;
