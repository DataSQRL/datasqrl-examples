-- ## Credit Cards - Test Data
--
-- Use local filesystem data for testing

IMPORT credit_cards.*;

CREATE TABLE Credit_Card_Account (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/credit_cards-credit_card_account.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Credit_Card_Account_schema;

CREATE TABLE Credit_Card (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/credit_cards-credit_card.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Credit_Card_schema;

