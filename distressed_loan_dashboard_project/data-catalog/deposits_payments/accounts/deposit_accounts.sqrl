-- ## Deposit Accounts
--
-- Core deposit account information including checking, savings, money market,
-- and certificate of deposit accounts. Contains account ownership, status history,
-- and product configuration data that forms the foundation of the bank's deposit
-- product portfolio.
--
-- Layer:            bronze
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA, Regulation E, Regulation DD

/** Primary deposit account record containing account attributes and status.
    Grain: one row per account_id. */
CREATE TABLE Account (
  /** Unique identifier for the account @npi */
  account_id STRING,
  /** Account number displayed to customer @npi @mask */
  account_number STRING,
  /** Account type: CHECKING, SAVINGS, MONEY_MARKET, CD, IRA */
  account_type STRING,
  /** Product code reference */
  product_code STRING,
  /** Account title or name @pii */
  account_title STRING,
  /** Account status: OPEN, CLOSED, DORMANT, FROZEN, ESCHEAT */
  account_status STRING,
  /** Date account was opened */
  opened_date DATE,
  /** Date account was closed (if applicable) */
  closed_date DATE,
  /** Reason for account closure */
  closure_reason STRING,
  /** Branch ID where account was opened */
  opening_branch_id STRING,
  /** Branch ID for account servicing */
  servicing_branch_id STRING,
  /** Account currency code (ISO 4217) */
  currency_code STRING,
  /** Current interest rate (annual percentage) */
  interest_rate DECIMAL(10, 6),
  /** Interest compounding frequency: DAILY, MONTHLY, QUARTERLY, ANNUALLY */
  compounding_frequency STRING,
  /** Interest payment frequency: MONTHLY, QUARTERLY, ANNUALLY, AT_MATURITY */
  interest_payment_frequency STRING,
  /** Maturity date for CDs */
  maturity_date DATE,
  /** Original term in months for CDs */
  original_term_months INT,
  /** Whether overdraft protection is enabled */
  overdraft_protection_enabled BOOLEAN,
  /** Linked account for overdraft protection @npi */
  overdraft_linked_account_id STRING,
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);

/** Account ownership and holder information linking customers to accounts.
    Grain: one row per account_id, customer_id combination. */
CREATE TABLE Account_Holder (
  /** Reference to account @npi */
  account_id STRING,
  /** Reference to customer @pii */
  customer_id STRING,
  /** Holder type: PRIMARY, JOINT, BENEFICIARY, CUSTODIAN, TRUSTEE, POA */
  holder_type STRING,
  /** Ownership percentage (for joint accounts) */
  ownership_percentage DECIMAL(5, 2),
  /** Whether holder has signing authority */
  has_signing_authority BOOLEAN,
  /** Date holder was added to account */
  added_date DATE,
  /** Date holder was removed from account */
  removed_date DATE,
  /** Whether this holder is currently active on the account */
  is_active BOOLEAN,
  /** Tax reporting responsibility percentage */
  tax_reporting_percentage DECIMAL(5, 2),
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);

/** Account status change history for audit and compliance tracking.
    Grain: one row per account_id, status_changed_at combination. */
CREATE TABLE Account_Status_History (
  /** Reference to account @npi */
  account_id STRING,
  /** Previous account status */
  previous_status STRING,
  /** New account status */
  new_status STRING,
  /** Reason for status change */
  change_reason STRING,
  /** Date and time status was changed */
  status_changed_at TIMESTAMP,
  /** Employee or system that initiated the change */
  changed_by STRING,
  /** Channel through which change was made: BRANCH, ONLINE, PHONE, SYSTEM */
  change_channel STRING,
  /** Additional notes about the status change @confidential */
  notes STRING,
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);

/** Deposit product configuration and terms reference data.
    Grain: one row per product_code, effective_from combination. */
CREATE TABLE Account_Product (
  /** Unique product code */
  product_code STRING,
  /** Product name */
  product_name STRING,
  /** Product category: CHECKING, SAVINGS, MONEY_MARKET, CD, IRA */
  product_category STRING,
  /** Whether product is currently available for new accounts */
  is_active BOOLEAN,
  /** Minimum opening deposit in cents */
  minimum_opening_deposit_cents BIGINT,
  /** Minimum balance to avoid fees in cents */
  minimum_balance_cents BIGINT,
  /** Monthly maintenance fee in cents */
  monthly_fee_cents BIGINT,
  /** Whether fee can be waived */
  fee_waiver_eligible BOOLEAN,
  /** Conditions for fee waiver */
  fee_waiver_conditions STRING,
  /** Base interest rate (APY) */
  base_interest_rate DECIMAL(10, 6),
  /** Interest rate tier structure (JSON) @confidential */
  rate_tiers STRING,
  /** Maximum transactions per month (Reg D for savings) */
  max_monthly_transactions INT,
  /** Whether account earns interest */
  interest_bearing BOOLEAN,
  /** FDIC insurance eligible */
  fdic_insured BOOLEAN,
  /** Date product became effective */
  effective_from DATE,
  /** Date product was discontinued */
  effective_to DATE,
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);
