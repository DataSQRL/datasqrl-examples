-- ## Card Transactions
--
-- Debit and prepaid card transaction data including real-time authorizations,
-- settlements, and chargeback processing. Captures the full lifecycle of
-- card-based payments from authorization through final settlement and any
-- disputes that may arise.
--
-- Layer:            bronze
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA, Regulation E, PCI-DSS

/** Real-time card authorization requests and responses.
    Grain: one row per authorization_id. */
CREATE TABLE Card_Authorization (
  /** Unique identifier for the authorization */
  authorization_id STRING,
  /** Reference to card used @pci @tokenize */
  card_id STRING,
  /** Reference to account @npi */
  account_id STRING,
  /** Authorization amount in cents @npi @confidential */
  authorization_amount_cents BIGINT,
  /** Currency code (ISO 4217) */
  currency_code STRING,
  /** Merchant amount if different currency in cents */
  merchant_amount_cents BIGINT,
  /** Merchant currency code */
  merchant_currency_code STRING,
  /** Exchange rate applied */
  exchange_rate DECIMAL(12, 6),
  /** Authorization status: APPROVED, DECLINED, PENDING, EXPIRED, REVERSED */
  authorization_status STRING,
  /** Decline reason code if declined */
  decline_reason_code STRING,
  /** Date and time of authorization */
  authorized_at TIMESTAMP,
  /** Authorization expiration timestamp */
  expires_at TIMESTAMP,
  /** Merchant name @pii */
  merchant_name STRING,
  /** Merchant ID */
  merchant_id STRING,
  /** Merchant Category Code */
  mcc_code STRING,
  /** Merchant city @pii */
  merchant_city STRING,
  /** Merchant state or province */
  merchant_state STRING,
  /** Merchant country code */
  merchant_country STRING,
  /** Transaction type: PURCHASE, CASH_ADVANCE, REFUND, BALANCE_INQUIRY */
  transaction_type STRING,
  /** Entry mode: CHIP, SWIPE, CONTACTLESS, MANUAL, ECOMMERCE, RECURRING */
  entry_mode STRING,
  /** Whether PIN was used */
  pin_used BOOLEAN,
  /** Whether card was present */
  card_present BOOLEAN,
  /** Network: VISA, MASTERCARD, DISCOVER, AMEX */
  network STRING,
  /** Network reference ID */
  network_reference_id STRING,
  /** Retrieval reference number */
  rrn STRING,
  /** Authorization code from network */
  authorization_code STRING,
  /** CVV verification result */
  cvv_result STRING,
  /** AVS verification result */
  avs_result STRING,
  /** 3D Secure result if applicable */
  three_ds_result STRING,
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);

/** Card transaction settlements from payment networks.
    Grain: one row per settlement_id. */
CREATE TABLE Card_Settlement (
  /** Unique identifier for the settlement */
  settlement_id STRING,
  /** Reference to original authorization */
  authorization_id STRING,
  /** Reference to posted transaction */
  transaction_id STRING,
  /** Reference to card @pci @tokenize */
  card_id STRING,
  /** Reference to account @npi */
  account_id STRING,
  /** Settlement amount in cents @npi @confidential */
  settlement_amount_cents BIGINT,
  /** Currency code (ISO 4217) */
  currency_code STRING,
  /** Original authorization amount in cents */
  authorization_amount_cents BIGINT,
  /** Difference between settlement and authorization in cents */
  variance_cents BIGINT,
  /** Settlement status: SETTLED, PENDING, REJECTED */
  settlement_status STRING,
  /** Date and time of settlement */
  settled_at TIMESTAMP,
  /** Settlement date from network */
  network_settlement_date DATE,
  /** Merchant name @pii */
  merchant_name STRING,
  /** Merchant ID */
  merchant_id STRING,
  /** Merchant Category Code */
  mcc_code STRING,
  /** Network: VISA, MASTERCARD, DISCOVER, AMEX */
  network STRING,
  /** Network reference ID */
  network_reference_id STRING,
  /** Interchange fee in cents @confidential */
  interchange_fee_cents BIGINT,
  /** Network assessment fee in cents @confidential */
  assessment_fee_cents BIGINT,
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);

/** Card dispute and chargeback records.
    Grain: one row per chargeback_id. */
CREATE TABLE Card_Chargeback (
  /** Unique identifier for the chargeback */
  chargeback_id STRING,
  /** Reference to original transaction */
  transaction_id STRING,
  /** Reference to settlement */
  settlement_id STRING,
  /** Reference to card @pci @tokenize */
  card_id STRING,
  /** Reference to account @npi */
  account_id STRING,
  /** Reference to customer @pii */
  customer_id STRING,
  /** Chargeback amount in cents @npi @confidential */
  chargeback_amount_cents BIGINT,
  /** Currency code (ISO 4217) */
  currency_code STRING,
  /** Chargeback status: INITIATED, PENDING, WON, LOST, EXPIRED */
  chargeback_status STRING,
  /** Reason code per network rules */
  reason_code STRING,
  /** Reason description @confidential */
  reason_description STRING,
  /** Category: FRAUD, CONSUMER_DISPUTE, PROCESSING_ERROR, AUTHORIZATION */
  chargeback_category STRING,
  /** Date chargeback was initiated */
  initiated_at TIMESTAMP,
  /** Response deadline */
  response_due_date DATE,
  /** Date chargeback was resolved */
  resolved_at TIMESTAMP,
  /** Resolution outcome: MERCHANT_WIN, CUSTOMER_WIN, SPLIT */
  resolution_outcome STRING,
  /** Amount recovered from merchant in cents */
  recovery_amount_cents BIGINT,
  /** Merchant name @pii */
  merchant_name STRING,
  /** Merchant ID */
  merchant_id STRING,
  /** Network handling the dispute */
  network STRING,
  /** Network case number */
  network_case_number STRING,
  /** Whether provisional credit was issued */
  provisional_credit_issued BOOLEAN,
  /** Date provisional credit was issued */
  provisional_credit_date DATE,
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);

/** Merchant Category Code reference data for transaction classification.
    Grain: one row per mcc_code. */
CREATE TABLE Mcc_Reference (
  /** Merchant Category Code */
  mcc_code STRING,
  /** MCC description */
  mcc_description STRING,
  /** Category grouping */
  category STRING,
  /** Subcategory */
  subcategory STRING,
  /** Whether MCC is considered high-risk */
  is_high_risk BOOLEAN,
  /** Whether MCC may indicate cash-like transaction */
  is_cash_equivalent BOOLEAN,
  /** Whether MCC is restricted for certain card programs */
  is_restricted BOOLEAN,
  /** Default tax category */
  tax_category STRING,
  /** Source system identifier */
  source_system STRING,
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP
);
