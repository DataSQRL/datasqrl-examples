-- ## Customer Enriched Data - Production
--
-- Writes enriched data to Apache Iceberg tables

IMPORT customer_enriched.*;

CREATE TABLE Customer_Profile (
  /** Timestamp when profile was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL,
  PRIMARY KEY (customer_id) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'customer',
    'catalog-database' = 'customer_data',
    'catalog-table' = 'customer_profile',
    'warehouse' = '${CUSTOMER_DATA_ICEBERG_WAREHOUSE}',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE Customer_Profile_schema;

CREATE TABLE Customer_Segment (
  /** Timestamp when segment was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL,
  PRIMARY KEY (customer_id, segment_type) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'customer',
    'catalog-database' = 'customer_data',
    'catalog-table' = 'customer_segment',
    'warehouse' = '${CUSTOMER_DATA_ICEBERG_WAREHOUSE}',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE Customer_Segment_schema;

CREATE TABLE Customer_Household (
  /** Timestamp when household was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL,
  PRIMARY KEY (household_id, customer_id) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'customer',
    'catalog-database' = 'customer_data',
    'catalog-table' = 'customer_household',
    'warehouse' = '${CUSTOMER_DATA_ICEBERG_WAREHOUSE}',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE Customer_Household_schema;

CREATE TABLE Customer_Lifetime_Value (
  /** Timestamp when CLV was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL,
  PRIMARY KEY (customer_id, calculation_date) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'customer',
    'catalog-database' = 'customer_data',
    'catalog-table' = 'customer_lifetime_value',
    'warehouse' = '${CUSTOMER_DATA_ICEBERG_WAREHOUSE}',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE Customer_Lifetime_Value_schema;
