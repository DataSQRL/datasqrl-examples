-- ## Customer Enriched Data - Test Data
--
-- Use local filesystem data for testing

IMPORT customer_enriched.*;

CREATE TABLE Customer_Profile (
  /** Timestamp when profile was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_enriched-customer_profile.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Profile_schema;

CREATE TABLE Customer_Segment (
  /** Timestamp when segment was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_enriched-customer_segment.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Segment_schema;

CREATE TABLE Customer_Household (
  /** Timestamp when household was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_enriched-customer_household.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Household_schema;

CREATE TABLE Customer_Lifetime_Value (
  /** Timestamp when CLV was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_enriched-customer_lifetime_value.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Lifetime_Value_schema;
