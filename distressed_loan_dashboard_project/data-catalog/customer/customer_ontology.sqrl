IMPORT customer_data.customer_master-{{environment}}.*;
IMPORT customer_data.kyc_aml-{{environment}}.*;

-- =====================================================
-- Relationships
-- =====================================================

/** Current customer addresses */
Customer.address := SELECT * FROM Customer_Address a WHERE this.customer_id = a.customer_id
                                  AND is_current ORDER BY effective_to DESC NULLS FIRST;

/** Complete history of customer addresses */
Customer.address_history := SELECT * FROM Customer_Address a WHERE this.customer_id = a.customer_id
                                                       ORDER BY effective_to DESC NULLS FIRST;

/** All contact information for the customer */
Customer.contacts := SELECT * FROM Customer_Contact c WHERE this.customer_id = c.customer_id;

/** Primary contact methods for the customer */
Customer.primary_contacts := SELECT * FROM Customer_Contact c WHERE this.customer_id = c.customer_id
                                                          AND is_primary;

/** Current employment information */
Customer.current_employment := SELECT * FROM Customer_Employment e WHERE this.customer_id = e.customer_id
                                                              AND employment_status = 'CURRENT';

/** Complete employment history */
Customer.employment_history := SELECT * FROM Customer_Employment e WHERE this.customer_id = e.customer_id
                                                              ORDER BY employment_start_date DESC;

/** Active relationships where this customer is the primary party */
Customer.relationships := SELECT * FROM Customer_Relationship r WHERE this.customer_id = r.primary_customer_id
                                                            AND is_active;

/** Complete relationship history where this customer is the primary party */
Customer.relationships_history := SELECT * FROM Customer_Relationship r WHERE this.customer_id = r.primary_customer_id
                                                                    ORDER BY relationship_start_date DESC;

/** KYC verification events for the customer */
Customer.kyc_verifications := SELECT * FROM Kyc_Verification k WHERE this.customer_id = k.customer_id
                                                           ORDER BY verified_at DESC;

/** Sanctions screening events for the customer */
Customer.sanctions_screenings := SELECT * FROM Sanctions_Screening s WHERE this.customer_id = s.customer_id
                                                                 ORDER BY screened_at DESC;

/** PEP screening events for the customer */
Customer.pep_screenings := SELECT * FROM Pep_Screening p WHERE this.customer_id = p.customer_id
                                                     ORDER BY screened_at DESC;

/** Current risk rating for the customer */
Customer.risk_rating := SELECT * FROM Customer_Risk_Rating r WHERE this.customer_id = r.customer_id
                                                         AND is_current ORDER BY effective_to DESC NULLS FIRST;

/** Complete risk rating history for the customer */
Customer.risk_rating_history := SELECT * FROM Customer_Risk_Rating r WHERE this.customer_id = r.customer_id
                                                                 ORDER BY effective_to DESC NULLS FIRST;

-- =====================================================
-- Data Quality & Assertions
-- =====================================================

/** Customer ID must be between 6-15 characters */
/*+test(no_rows) */
CustomerHasValidId_Test := SELECT * FROM Customer WHERE char_length(customer_id) < 6 OR char_length(customer_id) > 15;

/** Customer type must be a valid enumeration value */
/*+test(no_rows) */
CustomerHasValidType_Test := SELECT * FROM Customer
    WHERE customer_type NOT IN ('INDIVIDUAL', 'JOINT', 'TRUST', 'BUSINESS');

/** Customer status must be a valid enumeration value */
/*+test(no_rows) */
CustomerHasValidStatus_Test := SELECT * FROM Customer
    WHERE customer_status NOT IN ('ACTIVE', 'INACTIVE', 'CLOSED', 'DECEASED');

/** INDIVIDUAL customers must have date of birth; BUSINESS customers must not */
/*+test(no_rows) */
CustomerDOBConsistentWithType_Test := SELECT * FROM Customer
    WHERE (customer_type = 'INDIVIDUAL' AND date_of_birth IS NULL)
       OR (customer_type = 'BUSINESS' AND date_of_birth IS NOT NULL);

/** Every address must reference a customer that exists in Customer table */
/*+test(no_rows) */
AddressReferencesValidCustomer_Test := SELECT a.* FROM Customer_Address a
    LEFT JOIN Customer c ON a.customer_id = c.customer_id
    WHERE c.customer_id IS NULL;

/** Customer relationships cannot be self-referential (customer related to themselves) */
/*+test(no_rows) */
RelationshipNotSelfReferential_Test := SELECT * FROM Customer_Relationship
    WHERE primary_customer_id = related_customer_id;