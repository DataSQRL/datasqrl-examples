    "include": {
      "data-catalog": {
        "package": "../data-catalog/package.json"
      }
    },
    "config": {
      "environment": "test"
    }
  },
  "engines": {
    "flink": {
      "config": {
        "table.exec.source.idle-timeout": "10 s"
      },
      "deployment": {
