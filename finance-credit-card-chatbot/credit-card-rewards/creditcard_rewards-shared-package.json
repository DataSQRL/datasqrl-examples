{
  "version": "1",
  "enabled-engines": ["vertx", "postgres", "kafka", "flink"],
  "script": {
    "main": "creditcard_rewards.sqrl",
    "include": {
      "data-catalog": {
        "package": "../data-catalog/package.json"
      }
    }
  },
  "engines": {
    "flink": {
      "config": {
        "table.exec.source.idle-timeout": "10 s"
      }
    },
    "vertx": {
      "config": {
        "auth": {
          "issuers": [
            {
              "issuer": "dummy-issuer",
              "audiences": ["dummy-audience"],
              "keys": [{ "kty": "oct", "alg": "HS256", "k": "ZHVtbXktc3VwZXItc2VjcmV0LWp3dC1zaWduaW5nLXN0cmluZw" }]
            }
          ]
        }
      }
    }
  }
}
